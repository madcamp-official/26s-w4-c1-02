# Next.js / drizzle-kit 등이 hoist 안 된 의존을 런타임에 찾는 경우가 있어 shamefully-hoist 대신
# 필요한 것만 public-hoist 한다.
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
strict-peer-dependencies=false
auto-install-peers=true

# pnpm 11 이 스크립트 실행 전 의존성 상태를 검증하고 어긋나면 install 을 자동 실행한다.
# 컨테이너(비루트 · 오프라인)에서는 그 install 이 EACCES 로 죽어 migrate 가 못 돈다 —
# 이미지의 node_modules 는 빌드 때 --frozen-lockfile 로 이미 고정돼 있으므로 재검증이 불필요하다.
verify-deps-before-run=false
