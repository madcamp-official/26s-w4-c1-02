# Next.js / drizzle-kit 등이 hoist 안 된 의존을 런타임에 찾는 경우가 있어 shamefully-hoist 대신
# 필요한 것만 public-hoist 한다.
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
strict-peer-dependencies=false
auto-install-peers=true

# (의존성 재검증 끄기는 여기가 아니라 pnpm-workspace.yaml 의 verifyDepsBeforeRun 다 —
#  pnpm 10+ 는 pnpm 전용 설정을 .npmrc 에서 읽지 않는다. 여기 두면 죽은 글자다.)
