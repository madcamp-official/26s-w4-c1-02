# cp .env.example .env 후 채운다. .env 는 커밋하지 않는다.

# ── 인프라 (docker-compose.yml 기본값과 일치) ───────────────────────────
DATABASE_URL=postgres://endpointer:endpointer@localhost:5432/endpointer
REDIS_URL=redis://localhost:6379

# ── 인증 (P4 · A10) ────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# https://console.cloud.google.com/apis/credentials
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── LLM (P6 · A1 · ADR A14) ────────────────────────────────────────────
# https://aistudio.google.com/apikey  — 컴파일 시에만 호출된다
#
# ⚠ 기획서 8장의 모델 배분표(pro/flash)는 더 이상 유효하지 않다.
#   · gemini-2.5-pro 는 2025-12 에 무료 티어 한도가 사실상 0 으로 내려갔다
#     (가격표에는 "Free of charge" 로 남아 있으나 실제 쿼터가 없다)
#   · gemini-2.5-flash / -lite 는 2026-10-16 종료 예정이고 이미 404 보고가 있다
#   · 3.x 세대에 무료 Pro 는 존재하지 않는다
#   → 무료 티어에서 동작이 확인된 3.1-flash-lite 로 통일한다. 1M 컨텍스트 + 구조화 출력 지원.
#
# 키를 발급했으면 https://aistudio.google.com/rate-limit 에서 **본인 프로젝트의 실제 한도**를
# 반드시 눈으로 확인해라. 공식 문서에는 모델별 무료 한도표가 더 이상 게시되지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL_COMPILE=gemini-3.1-flash-lite
GEMINI_MODEL_MATCH=gemini-3.1-flash-lite

# 개발 중 쿼터 소진 방지 (무료 티어는 하루 호출 수가 매우 적다).
# 같은 입력으로 재호출하지 않도록 컴파일 결과를 디스크에 캐싱한다.
LLM_CACHE_DIR=.cache/llm
LLM_CACHE_ENABLED=true
# 프롬프트에 넣기 전 HTML 에서 script/style/svg/주석/data-URI 를 제거한다 (보통 60~90% 감축)
LLM_HTML_TRIM=true
LLM_MAX_INPUT_CHARS=400000

# ── 구독 발송 (P7 · A11) ───────────────────────────────────────────────
# 웹훅은 의존성 0. 이메일은 G4 에서 붙인다.
RESEND_API_KEY=
SUBSCRIPTION_FROM_EMAIL=

# ── 공개 주소 (O1 · 도메인 미정, G4 이전에 정한다) ──────────────────────
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
PUBLIC_MCP_BASE_URL=http://localhost:3002

# ── 수집 안정성 (6장 기술적 예의) ──────────────────────────────────────
CRAWLER_USER_AGENT=endpointer/0.1 (+https://github.com/madcamp-official/26s-w4-c1-02)
CRAWLER_MIN_INTERVAL_MS=1500
CRAWLER_MAX_PAGES=3
CRAWLER_CACHE_TTL_S=3600

# 서버가 사설망 주소로 나가는 것을 허용한다. **개발용 탈출구다 — 배포에서 켜지 마라.**
# 켜면 사용자가 붙여넣은 주소로 서버가 내부망(로컬 DB·사내망·클라우드 메타데이터)을 열 수 있다.
# 로컬 픽스처를 대상으로 돌릴 때만 켠다 (`create-collection --allow-private` 이 이걸 켠다).
ALLOW_PRIVATE_HOSTS=false

# ── 워커 (15장 Playwright 메모리 리스크) ───────────────────────────────
WORKER_CONCURRENCY=2
BROWSER_CONCURRENCY=1
HEAL_MAX_ATTEMPTS_PER_DAY=3

# ── 포트 ───────────────────────────────────────────────────────────────
WEB_PORT=3000
MCP_PORT=3002
