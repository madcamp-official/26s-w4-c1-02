# 배포용 환경변수. cp .env.production.example .env 후 채운다.
# docker compose 는 compose 파일이 있는 디렉터리(= deploy/)의 .env 를 자동으로 읽는다.
# 이 파일은 레포 루트의 .env.example 과 겹치되, 값이 "컨테이너 내부 기준"이라는 점이 다르다.
# localhost 가 아니라 서비스 이름(postgres / redis)으로 붙는다.
#
# .env 는 절대 커밋하지 않는다.

# ── 도메인 (16장 O1 — G4 이전에 확정한다) ──────────────────────────────
# 세 개 모두 VM 의 공인 IP 로 A 레코드가 걸려 있어야 Let's Encrypt 발급이 된다.
APP_DOMAIN=example.com
API_DOMAIN=api.example.com
MCP_DOMAIN=mcp.example.com
# 인증서 만료 경고를 받을 주소
ACME_EMAIL=you@example.com

TZ=Asia/Seoul

# ── Postgres ───────────────────────────────────────────────────────────
POSTGRES_USER=endpointer
POSTGRES_DB=endpointer
# openssl rand -hex 24
POSTGRES_PASSWORD=

# DATABASE_URL / REDIS_URL 은 compose 가 위 값으로 조립한다 (docker-compose.prod.yml 상단 x-app-env).
# 컨테이너 밖에서(예: 마이그레이션을 호스트에서 돌릴 때) 쓰려면 이 형태다:
#   DATABASE_URL=postgres://endpointer:<POSTGRES_PASSWORD>@postgres:5432/endpointer
#   REDIS_URL=redis://redis:6379

# ── 인증 (P4 · ADR A10) ────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# AUTH_URL / AUTH_TRUST_HOST 는 compose 가 APP_DOMAIN 에서 만든다.
# Google Cloud Console 의 승인된 리디렉션 URI 에 이걸 등록해라:
#   https://<APP_DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── LLM (P6 · ADR A1) ──────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_COMPILE=gemini-3.1-flash-lite
GEMINI_MODEL_MATCH=gemini-3.1-flash-lite
LLM_CACHE_ENABLED=true
LLM_HTML_TRIM=true
LLM_MAX_INPUT_CHARS=400000
# LLM_CACHE_DIR 은 컨테이너 안에서 /app/.cache/llm 로 고정이고 named volume(llmcache)이 붙는다

# ── 구독 발송 (P7 · ADR A11) ───────────────────────────────────────────
RESEND_API_KEY=
SUBSCRIPTION_FROM_EMAIL=

# ── 수집 안정성 (6장 기술적 예의) ──────────────────────────────────────
CRAWLER_USER_AGENT=endpointer/0.1 (+https://github.com/madcamp-official/26s-w4-c1-02)
CRAWLER_MIN_INTERVAL_MS=1500
CRAWLER_MAX_PAGES=3
CRAWLER_CACHE_TTL_S=3600

# ── 워커 동시성 (15장 Playwright 메모리 리스크) ────────────────────────
# 이 값을 올릴 거면 MEM_WORKER 도 같이 올려라. Chromium 인스턴스 하나가 300~600MB 를 먹는다.
WORKER_CONCURRENCY=2
BROWSER_CONCURRENCY=1
HEAL_MAX_ATTEMPTS_PER_DAY=3

# ── 컨테이너 자원 상한 (기본값 = 2vCPU / 8GB VM 기준) ──────────────────
# 합계 약 6.8GB. 나머지는 호스트 OS 와 도커 데몬 몫으로 남긴다.
# 4GB VM 이면 MEM_WORKER=1500m / BROWSER_CONCURRENCY=1 로 낮추고 MEM_WEB=1g 로 줄여라.
MEM_CADDY=256m
MEM_WEB=1536m
MEM_WORKER=3g
MEM_MCP=512m
MEM_POSTGRES=1g
MEM_REDIS=512m
MEM_MIGRATE=512m

CPU_CADDY=0.5
CPU_WEB=1.0
CPU_WORKER=1.5
CPU_MCP=0.5
CPU_POSTGRES=1.0
CPU_REDIS=0.5

# Chromium 의 /dev/shm. 기본 64MB 로는 탭이 죽는다
SHM_WORKER=1gb
# BullMQ 는 evict 되면 안 되므로 noeviction 이다. mem_limit 보다 낮게 잡아라
REDIS_MAXMEMORY=384mb
